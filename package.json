{
  "name": "prowlio",
  "version": "3.0.0",
  "description": "Prowlio - Addon de streaming pour Stremio et Nuvio avec Prowlarr, Jackett et plusieurs fournisseurs de débridage",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D4rk56/Prowlio.git"
  },
  "homepage": "https://github.com/D4rk56/Prowlio#readme",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "start:legacy": "node --experimental-sqlite index.js",
    "start:dev": "node --experimental-sqlite --import tsx src/index.ts",
    "test": "node --test --test-concurrency=1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "anitomy-js": "^5.4.0",
    "axios": "^1.7.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "proxy-agent": "^8.0.2",
    "socks-proxy-agent": "^10.1.0",
    "string-similarity": "^4.0.4",
    "tmdb-kit": "^1.0.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "@tootallnate/once": "^2.0.1"
  },
  "allowScripts": {
    "anitomy-js@5.4.0": true
  }
}
